# Copy to .env next to engine.py and fill in. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey). Required.
API_GEMINI=

# Linkup web search key (https://linkup.so). Recommended: without it, the check relies on Gemini's own Google Search only,
# and Gemini often answers from memory, leaving no usable source.
API_LINKUP=

# How the sources are looked for: linkup_first (Linkup's pages given to Gemini from the start) or google_first (Gemini and
# Google Search first, Linkup only when no usable link came back). Without API_LINKUP it is always google_first.
CHECK_ORDER=linkup_first

# Where the journal of the checks is written: one JSON line per check, one file per day (checks-YYYY-MM-DD.jsonl).
# Default: the logs/ folder next to engine.py. Empty = no journal.
# CHECK_LOG=logs

# Optional
# GEMINI_MODEL=gemini-3.8-flash                  the check
# GEMINI_PREFLIGHT_MODEL=gemini-3.5-flash-lite   writes the Linkup query
# GEMINI_API_VERSION=v1
# HOST=127.0.0.1
# PORT=8050
